 public class CapMiddleware
{
    private readonly RequestDelegate _next;
    private readonly IConfiguration _config;
    private readonly IMemoryCache _cache;

    public CapMiddleware(
        RequestDelegate next,
        IConfiguration config,
        IMemoryCache cache)
    {
        _next = next;
        _config = config;
        _cache = cache;
    }

    public async Task InvokeAsync(HttpContext context, CapAuthService capService)
    {
        var enabled = _config.GetValue<bool>("CapAuth:Enabled");

        if (!enabled)
        {
            await _next(context);
            return;
        }

        var cookieName = _config["CapAuth:CookieName"];
        var path = context.Request.Path.Value?.ToLower() ?? "";

        // =========================
        // 1. 靜態資源
        // =========================
        if (path.StartsWith("/css") ||
            path.StartsWith("/js") ||
            path.StartsWith("/lib") ||
            path.StartsWith("/images") ||
            path.StartsWith("/favicon"))
        {
            await _next(context);
            return;
        }

        // =========================
        // 2. Auth
        // =========================
        if (path.StartsWith("/auth"))
        {
            await _next(context);
            return;
        }

        // =========================
        // 3. iframe token login（最高優先）
        // =========================
        var tokenParam = context.Request.Query["token"].ToString();

        if (!string.IsNullOrWhiteSpace(tokenParam))
        {
            var payload = ValidateIframeToken(tokenParam);

            if (payload != null)
            {
                var currentEmpId = context.User?.FindFirst("EmployeeId")?.Value;

                // Case A：同工號 → 不重登
                if (!string.IsNullOrEmpty(currentEmpId) &&
                    currentEmpId == payload.EmpId)
                {
                    await _next(context);
                    return;
                }

                // Case B：不同工號 → 查 user + 覆蓋登入
                var user = await capService.GetUserByEmpIdAsync(payload.EmpId);

                if (user == null)
                {
                    context.Response.StatusCode = 401;
                    await context.Response.WriteAsync("User not found");
                    return;
                }

                await SignIn(context, user);

                context.Response.Cookies.Delete("CAP_RETRY");

                await _next(context);
                return;
            }
        }

        // =========================
        // 4. CAP retry 防 loop
        // =========================
        if (context.Request.Cookies["CAP_RETRY"] == "1")
        {
            context.Response.StatusCode = 401;
            await context.Response.WriteAsync("SSO failed (loop blocked)");
            return;
        }

        // =========================
        // 5. 已登入（CAP 或 cookie）
        // =========================
        if (context.User.Identity?.IsAuthenticated == true)
        {
            await _next(context);
            return;
        }

        // =========================
        // 6. CAP fallback
        // =========================
        var capToken = context.Request.Cookies[cookieName];

        if (string.IsNullOrWhiteSpace(capToken))
        {
            RedirectToCap(context);
            return;
        }

        var capUser = await capService.GetUserInfoAsync(capToken);

        if (capUser == null)
        {
            context.Response.Cookies.Delete(cookieName);
            RedirectToCap(context);
            return;
        }

        await SignIn(context, capUser);

        context.Response.Cookies.Delete("CAP_RETRY");

        await _next(context);
    }

    // =====================================================
    // TOKEN 解析（取代 empId/ts/nonce/sig）
    // =====================================================
    private IframePayload ValidateIframeToken(string token)
    {
        try
        {
            var secret = _config["CapAuth:IframeSecret"];

            var parts = token.Split('.');
            if (parts.Length != 2) return null;

            var payloadBase64 = parts[0];
            var sig = parts[1];

            // 驗簽
            using (var hmac = new HMACSHA256(Encoding.UTF8.GetBytes(secret)))
            {
                var expected = Convert.ToBase64String(
                    hmac.ComputeHash(Encoding.UTF8.GetBytes(payloadBase64))
                );

                if (expected != sig)
                    return null;
            }

            // 解 payload
            var json = Encoding.UTF8.GetString(
                Convert.FromBase64String(payloadBase64)
            );

            var payload = JsonSerializer.Deserialize<IframePayload>(json);

            if (payload == null)
                return null;

            // 時間驗證（5分鐘）
            var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
            if (Math.Abs(now - payload.Ts) > 300)
                return null;

            // nonce 防重放
            if (_cache.TryGetValue("nonce_" + payload.Nonce, out _))
                return null;

            _cache.Set("nonce_" + payload.Nonce, true, TimeSpan.FromMinutes(5));

            return payload;
        }
        catch
        {
            return null;
        }
    }

    // =====================================================
    // 統一登入
    // =====================================================
    private async Task SignIn(HttpContext context, CapUserInfo user)
    {
        var claims = new List<Claim>
        {
            new Claim(ClaimTypes.NameIdentifier, user.UserId ?? ""),
            new Claim(ClaimTypes.Name, user.RealName ?? ""),
            new Claim("EmployeeId", user.EmployeeId ?? ""),
            new Claim(ClaimTypes.Email, user.Email ?? ""),
            new Claim("DepartmentId", user.DepartmentId ?? ""),
            new Claim("BossLevel", user.BossLevel.ToString()),
            new Claim("CompanyName", user.CompanyName ?? ""),
            new Claim("Site", user.Site ?? ""),
            new Claim("Photo", ExtendTool.GetUserPhotoUrl(user.EmployeeId))
        };

        var identity = new ClaimsIdentity(
            claims,
            CookieAuthenticationDefaults.AuthenticationScheme);

        var principal = new ClaimsPrincipal(identity);

        await context.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            principal);

        context.User = principal;
    }

    // =====================================================
    // CAP redirect
    // =====================================================
    private void RedirectToCap(HttpContext context)
    {
        var loginUrl = _config["CapAuth:LoginUrl"];

        var returnUrl =
            $"{context.Request.Scheme}://{context.Request.Host}{context.Request.Path}{context.Request.QueryString}";

        context.Response.Cookies.Append(
            "CAP_RETRY",
            "1",
            new CookieOptions
            {
                Expires = DateTimeOffset.UtcNow.AddMinutes(5),
                HttpOnly = true,
                Secure = true,
                SameSite = SameSiteMode.Lax
            });

        context.Response.Redirect(
            loginUrl + "?ReturnUrl=" + Uri.EscapeDataString(returnUrl)
        );
    }

    // =====================================================
    // Payload model
    // =====================================================
    private class IframePayload
    {
        public string EmpId { get; set; }
        public long Ts { get; set; }
        public string Nonce { get; set; }
    }
}





public class CapMiddleware
{
    private readonly RequestDelegate _next;
    private readonly IConfiguration _config;
    private readonly IMemoryCache _cache;

    public CapMiddleware(
        RequestDelegate next,
        IConfiguration config,
        IMemoryCache cache)
    {
        _next = next;
        _config = config;
        _cache = cache;
    }

    public async Task InvokeAsync(HttpContext context, CapAuthService capService)
    {
        var enabled = _config.GetValue<bool>("CapAuth:Enabled");

        if (!enabled)
        {
            await _next(context);
            return;
        }

        var cookieName = _config["CapAuth:CookieName"];
        var path = context.Request.Path.Value?.ToLower() ?? "";

        // =========================
        // 1. 靜態資源
        // =========================
        if (path.StartsWith("/css") ||
            path.StartsWith("/js") ||
            path.StartsWith("/lib") ||
            path.StartsWith("/images") ||
            path.StartsWith("/favicon"))
        {
            await _next(context);
            return;
        }

        // =========================
        // 2. Auth
        // =========================
        if (path.StartsWith("/auth"))
        {
            await _next(context);
            return;
        }

        // =========================
        // 3. iframe token login（最高優先）
        // =========================
        var tokenParam = context.Request.Query["token"].ToString();

        if (!string.IsNullOrWhiteSpace(tokenParam))
        {
            var payload = ValidateIframeToken(tokenParam);

            if (payload != null)
            {
                var currentEmpId =
                    context.User?.FindFirst("EmployeeId")?.Value;

                var currentSource =
                    context.User?.FindFirst("AuthSource")?.Value;

                // =================================================
                // ⭐ CAP session 不允許被 iframe override（關鍵）
                // =================================================
                if (currentSource == "CAP")
                {
                    await _next(context);
                    return;
                }

                // =========================
                // Case A：同工號 → 不重登
                // =========================
                if (!string.IsNullOrEmpty(currentEmpId) &&
                    currentEmpId == payload.EmpId)
                {
                    await _next(context);
                    return;
                }

                // =========================
                // Case B：不同工號 → override login
                // =========================
                var user = await capService.GetUserByEmpIdAsync(payload.EmpId);

                if (user == null)
                {
                    context.Response.StatusCode = 401;
                    await context.Response.WriteAsync("User not found");
                    return;
                }

                await SignIn(context, user, "IFRAME");

                context.Response.Cookies.Delete("CAP_RETRY");

                await _next(context);
                return;
            }
        }

        // =========================
        // 4. CAP retry 防 loop
        // =========================
        if (context.Request.Cookies["CAP_RETRY"] == "1")
        {
            context.Response.StatusCode = 401;
            await context.Response.WriteAsync("SSO failed (loop blocked)");
            return;
        }

        // =========================
        // 5. 已登入（CAP or IFRAME session）
        // =========================
        if (context.User.Identity?.IsAuthenticated == true)
        {
            await _next(context);
            return;
        }

        // =========================
        // 6. CAP fallback
        // =========================
        var capToken = context.Request.Cookies[cookieName];

        if (string.IsNullOrWhiteSpace(capToken))
        {
            RedirectToCap(context);
            return;
        }

        var capUser = await capService.GetUserInfoAsync(capToken);

        if (capUser == null)
        {
            context.Response.Cookies.Delete(cookieName);
            RedirectToCap(context);
            return;
        }

        await SignIn(context, capUser, "CAP");

        context.Response.Cookies.Delete("CAP_RETRY");

        await _next(context);
    }

    // =====================================================
    // iframe token 驗證（防改 + 防重放）
    // =====================================================
    private IframePayload ValidateIframeToken(string token)
    {
        try
        {
            var secret = _config["CapAuth:IframeSecret"];

            var parts = token.Split('.');
            if (parts.Length != 2) return null;

            var payloadBase64 = parts[0];
            var sig = parts[1];

            // 驗簽
            using (var hmac = new HMACSHA256(Encoding.UTF8.GetBytes(secret)))
            {
                var expected = Convert.ToBase64String(
                    hmac.ComputeHash(Encoding.UTF8.GetBytes(payloadBase64))
                );

                if (expected != sig)
                    return null;
            }

            // 解 payload
            var json = Encoding.UTF8.GetString(
                Convert.FromBase64String(payloadBase64)
            );

            var payload = JsonSerializer.Deserialize<IframePayload>(json);

            if (payload == null)
                return null;

            // =========================
            // 5分鐘有效
            // =========================
            var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
            if (Math.Abs(now - payload.Ts) > 300)
                return null;

            // =========================
            // nonce 防重放
            // =========================
            var nonceKey = "nonce_" + payload.Nonce;

            if (_cache.TryGetValue(nonceKey, out _))
                return null;

            _cache.Set(nonceKey, true, TimeSpan.FromMinutes(5));

            return payload;
        }
        catch
        {
            return null;
        }
    }

    // =====================================================
    // 統一登入（加入來源 CAP / IFRAME）
    // =====================================================
    private async Task SignIn(HttpContext context, CapUserInfo user, string source)
    {
        var claims = new List<Claim>
        {
            new Claim(ClaimTypes.NameIdentifier, user.UserId ?? ""),
            new Claim(ClaimTypes.Name, user.RealName ?? ""),
            new Claim("EmployeeId", user.EmployeeId ?? ""),
            new Claim(ClaimTypes.Email, user.Email ?? ""),
            new Claim("DepartmentId", user.DepartmentId ?? ""),
            new Claim("BossLevel", user.BossLevel.ToString()),
            new Claim("CompanyName", user.CompanyName ?? ""),
            new Claim("Site", user.Site ?? ""),
            new Claim("Photo", ExtendTool.GetUserPhotoUrl(user.EmployeeId)),

            // ⭐ 關鍵：來源標記
            new Claim("AuthSource", source)
        };

        var identity = new ClaimsIdentity(
            claims,
            CookieAuthenticationDefaults.AuthenticationScheme);

        var principal = new ClaimsPrincipal(identity);

        await context.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            principal);

        context.User = principal;
    }

    // =====================================================
    // CAP redirect
    // =====================================================
    private void RedirectToCap(HttpContext context)
    {
        var loginUrl = _config["CapAuth:LoginUrl"];

        var returnUrl =
            $"{context.Request.Scheme}://{context.Request.Host}{context.Request.Path}{context.Request.QueryString}";

        context.Response.Cookies.Append(
            "CAP_RETRY",
            "1",
            new CookieOptions
            {
                Expires = DateTimeOffset.UtcNow.AddMinutes(5),
                HttpOnly = true,
                Secure = true,
                SameSite = SameSiteMode.Lax
            });

        context.Response.Redirect(
            loginUrl + "?ReturnUrl=" + Uri.EscapeDataString(returnUrl)
        );
    }

    // =====================================================
    // payload model
    // =====================================================
    private class IframePayload
    {
        public string EmpId { get; set; }
        public long Ts { get; set; }
        public string Nonce { get; set; }
    }
}

