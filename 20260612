					container
				);

			if (target.type === "file") {

				const result =
					await window.PreviewModule.importfile({
						stepKey,
						key,
						store,
						container,
						target,
						newValue
					});

				if (!result) {
					alert("fail");
				}

				return;
			}

			GraphV2.notify(
				stepKey,
				key,
				newValue,
				{
					virtual:
						RuntimeHelpers.getVirtual(target)
				}
			);
		};

		adapter.bind(
			el,
			update
		);

		const blurHandler = () => {

			store.setTouched(
