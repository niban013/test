			val === null ||
			val === undefined ||
			val === "" ||
			(Array.isArray(val) && val.length === 0) ||
			(val instanceof File && !val);

		// required
		if (show && isEmptyval && required) {

			return {
				state: "error",
				message: "必填"
			};
		}
		if (!show && !isEmptyval && isEmpty(error) && !required) {

			return {
				state: "success",
				message: ""
			};
		}
		// valid
		if (show && !isEmptyval && isEmpty(error)) {

			return {
				state: "success",
				message: ""
			};
		}

		// untouched empty
		if (!show && !val) {

			return {
				state: null,
				message: ""
			};
		}

		// processing
		if (status === "processing") {

			if (val) {

				return {
					state: "success",
					message: ""
				};
			}

			if (!val && !required) {

				return {
					state: null,
					message: ""
				};
			}

			return {
				state: "processing",
				message: ""
			};
		}

		// error
		if (status === "error") {

			return {
				state: "error",
				message: error || ""
			};
		}
		if (status === "success" && !required) {
			return {
				state: null,
				message: ""
			};
		}
		// success
		if (status === "success") {

