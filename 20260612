	function waitForOptionsReady(el, timeout = 5000) {

		return new Promise(resolve => {

			const $el = $(el);

			let done = false;
			let timer = null;

			const isSelect2 = !!$el.data("select2");

			const check = () => {

				if (done) return;

				// =========================
				// 1. native select options ready
				// =========================
				const hasOptions =
					el.options &&
					el.options.length > 1;

				// =========================
				// 2. custom async flag（你 API 可控制）
				// =========================
				const datasetReady =
					el.dataset.optionsReady === "1" ||
					el.dataset.asyncReady === "1" ||
					el.dataset.optionsLoaded === "1";

				// =========================
				// 3. select2 render ready（避免 early setValue）
				// =========================
				const select2Ready =
					!isSelect2 ||
					($el.data("select2") &&
						$el.data("select2").$container);

				// =========================
				// READY CONDITION
				// =========================
				if (hasOptions || datasetReady) {

					done = true;
					clearTimeout(timer);
					resolve(true);
					return;
				}

				requestAnimationFrame(check);
