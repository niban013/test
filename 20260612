	function bindFields(container, stepKey, mode = "editable") {

		const plugins = AppBootstrap.get("FilePlugin");
		const store = AppBootstrap.get("FlowStore");

		const isReadOnly = mode === "readOnly";

		container.querySelectorAll("[data-field]").forEach(el => {

			if (el.dataset.bound) return;
			el.dataset.bound = "1";

			const key = getKey(el);
			const adapter = FieldAdapters.resolve(el);

			const value = getInitialValue(
					el,
					stepKey,
					store
				);

			// =====================
			// READONLY
			// =====================

			if (isReadOnly) {

				if (el.type === "file") {
					plugins.init(el, {
						stepKey,
						key
					});
				}

				adapter.setValue(el, value );

				adapter.disable(el, true );

				return;
			}

			// =====================
			// EDITABLE
			// =====================

			registerValidationRules(
				el,
				stepKey
			);

			// runtime
			if (
				RuntimeHelpers.getVirtual(el)
				=== "runtime"
			) {

				GraphV2.setRuntime(
					stepKey,
					key,
					adapter.getValue(el)
				);

				return;
			}

			// file plugin
			if (el.type === "file") {

				plugins.init(el, {
					stepKey,
					key
				});
